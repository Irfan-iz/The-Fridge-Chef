<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The Fridge Chef — Dashboard</title>
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#ff6b00">
  <link rel="stylesheet" href="/static/css/style.css" />
  <script>document.documentElement.setAttribute('data-theme', localStorage.getItem('theme') || 'light');</script>
</head>
<body>
<div class="loading-overlay" id="loadingOverlay">
  <div class="spinner"></div>
  <p id="loadingText">Processing...</p>
</div>

<!-- Custom Logout Modal -->
<div id="logoutModal" class="logout-overlay" style="display:none;">
  <div class="logout-content card">
    <div style="font-size: 3rem; margin-bottom: 16px;">🚪</div>
    <h3 style="font-family: 'Playfair Display', serif; font-size: 1.5rem; margin-bottom: 8px;">Ready to leave?</h3>
    <p style="color: var(--text-muted); margin-bottom: 24px; font-size: 0.95rem;">Are you sure you want to log out of your session?</p>
    <div style="display: flex; gap: 12px; width: 100%;">
      <button class="btn btn-secondary" style="flex: 1;" onclick="closeLogoutModal()">Cancel</button>
      <button class="btn btn-danger" style="flex: 1;" onclick="handleLogout()">Yes, Log Out</button>
    </div>
  </div>
</div>

<div class="app-layout">
  <aside class="sidebar">
    <div class="sidebar-logo">
      <h1>The Fridge<span>Chef</span></h1>
      <p>AI Culinary Assistant</p>
    </div>
    <div class="sidebar-user">
      <div class="user-avatar" id="userAvatar">U</div>
      <div class="user-info">
        <p id="sidebarUsername">User</p>
        <span id="sidebarGoal">—</span>
      </div>
    </div>
    <nav class="sidebar-nav">
      <div class="nav-section-label">Kitchen</div>
      <button class="nav-item active" onclick="switchTab('inventory',this)"><span class="nav-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg></span> My Fridge</button>
      <button class="nav-item" onclick="switchTab('planner',this)"><span class="nav-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg></span> Meal Engine</button>
      <button class="nav-item" onclick="switchTab('cookbook',this)"><span class="nav-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg></span> Cookbook</button>
      <button class="nav-item" onclick="switchTab('quicklist',this)"><span class="nav-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg></span> Quick List</button>
      <div class="nav-section-label" style="margin-top:12px;">Account</div>
      <button class="nav-item" onclick="switchTab('profile',this)"><span class="nav-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></span> My Profile</button>
      <button class="nav-item nav-logout" onclick="showLogoutModal()"><span class="nav-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg></span> Logout</button>
    </nav>
    <div class="sidebar-bottom">
      <div style="font-size:.72rem;color:#57534E;text-align:center;">
        BMI: <strong id="sidebarBmi" style="color:var(--accent);">—</strong> &nbsp;|&nbsp;
        <span id="sidebarActivity" style="color:#78716C;"></span>
      </div>
    </div>
  </aside>

  <div class="main-content">
    <div class="topbar">
      <div style="display: flex; align-items: center;">
        <button class="btn btn-ghost btn-sm" id="mobileMenuBtn" style="display:none; font-size:1.4rem; padding:4px 8px; margin-right:12px; border:none;">☰</button>
        <div class="topbar-title" id="topbarTitle">🧊 My Fridge</div>
      </div>
      <div class="topbar-actions">
        <button class="theme-toggle" id="themeToggle">🌙</button>
      </div>
    </div> 
    
    <div class="page-content">

      <div class="tab-panel active" id="tab-inventory">
        <div class="grid-2" style="align-items:start;">
          <div>
            <div class="card" style="margin-bottom:18px;">
              <div class="card-header"><div class="card-title">Add Ingredient</div></div>
              <div class="vision-mode-selector">
                <button class="mode-btn active" onclick="setMode('camera',this)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:text-bottom;margin-right:4px;"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg> Camera</button>
                <button class="mode-btn" onclick="setMode('upload',this)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:text-bottom;margin-right:4px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg> Upload</button>
                <button class="mode-btn" onclick="setMode('gemini',this)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:text-bottom;margin-right:4px;"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path></svg> Gemini</button>
                <button class="mode-btn" onclick="setMode('manual',this)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:text-bottom;margin-right:4px;"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg> Manual</button>
              </div>
              <div id="mode-camera">
                <video id="cameraStream" autoplay playsinline style="width:100%;border-radius:var(--radius);max-height:220px;object-fit:cover;display:none;"></video>
                <canvas id="cameraCanvas" style="display:none;"></canvas>
                
                <div class="camera-area" id="cameraStartArea" onclick="startCamera()" style="display: flex; flex-direction: column; justify-content: center; align-items: center; min-height: 220px; cursor: pointer;">
                  <div style="margin-bottom: 8px; opacity: 0.9;"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg></div>
                  <h3 style="margin: 0 0 6px 0; font-size: 1.1rem; color: var(--text-primary);">AI Vision Offline</h3>
                  <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 16px; text-align: center; max-width: 80%; line-height: 1.4;">
                    Initialize scanner to identify raw ingredients, vegetables, and proteins in real-time.
                  </p>
                </div>

                <img id="camera-preview" alt="captured" style="width:100%;border-radius:var(--radius);max-height:220px;object-fit:cover;display:none;margin-top:8px;" />
                <div style="display:flex;gap:8px;margin-top:10px;">
                  <button class="btn btn-secondary btn-sm" id="captureBtnEl" onclick="capturePhoto()" style="display:none;flex:1;">📸 Capture</button>
                  <button class="btn btn-primary btn-sm" id="scanCameraBtn" onclick="scanCamera()" style="display:none;flex:1;">🔍 Identify Object</button>
                </div>
              </div>
              <div id="mode-upload" style="display:none;">
                <div class="camera-area" onclick="document.getElementById('uploadInput').click()">
                  <div style="margin-bottom: 12px; opacity: 0.7;"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg></div><p>Click to upload ingredient photo</p>
                </div>
                <input type="file" id="uploadInput" accept="image/*" style="display:none;" onchange="handleUpload(event)" />
                <img id="upload-preview" alt="preview" style="width:100%;border-radius:var(--radius);max-height:200px;object-fit:cover;display:none;margin-top:10px;" />
                <button class="btn btn-primary btn-sm" id="scanUploadBtn" onclick="scanUpload()" style="display:none;margin-top:10px;width:100%;">🔍 Identify (CNN)</button>
              </div>
              <div id="mode-gemini" style="display:none;">
                <div class="camera-area" onclick="document.getElementById('geminiInput').click()">
                  <div style="margin-bottom: 12px; opacity: 0.7;"><svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"></path></svg></div>
                  <p>Click to upload photo for Gemini AI Analysis</p>
                  <p style="font-size:.75rem;margin-top:4px;">Gemini detects <strong>all</strong> items at once</p>
                </div>
                <input type="file" id="geminiInput" accept="image/*" style="display:none;" onchange="handleGeminiPreview(event)" />
                <img id="gemini-preview" alt="preview" style="width:100%;border-radius:var(--radius);max-height:200px;object-fit:cover;display:none;margin-top:10px;" />
                <button class="btn btn-primary btn-sm" id="scanGeminiBtn" onclick="scanGemini()" style="display:none;margin-top:10px;width:100%;">🧠 Scan with Gemini AI</button>
              </div>
              <div id="mode-manual" style="display:none;">
                <div class="form-group">
                  <label class="form-label">Type ingredient name</label>
                  <input type="text" class="form-input" id="manualInput" placeholder="e.g. Carrot" />
                </div>
                <button class="btn btn-primary" onclick="addManual()" style="width:100%; padding: 12px; font-weight: 700;">Add to Fridge</button>
              </div>
              <div id="scanResult" style="margin-top:12px;"></div>
            </div>
          </div>
          <div>
            <div class="card">
              <div class="card-header">
                <div class="card-title"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;vertical-align:text-bottom;"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg> My Fridge (<span id="fridgeCount">0</span>)</div>
                <button class="btn btn-ghost btn-sm" onclick="clearFridge()"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:text-bottom;margin-right:4px;"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg> Clear</button>
              </div>
              <div id="fridgeList">
                <div class="empty-state">
                  <div style="opacity: 0.15; margin-bottom: 16px;">
                    <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                  </div>
                  <p style="font-weight: 500; font-size: 0.95rem; color: var(--text-primary); margin-bottom: 4px;">Your fridge is empty.</p>
                  <p style="font-size: 0.8rem; color: var(--text-muted);">Add ingredients using the scanner to get started.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="tab-panel" id="tab-planner">
        <div class="grid-2">
          
          <div class="constraints-panel">
            <div class="constraint-card">
              <div class="constraint-header"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;vertical-align:text-bottom;"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg> Resources (Economy & Time)</div>
              
              <div class="constraint-group">
                <span class="constraint-label">Budget Range (RM)</span>
                <div class="range-wrapper" style="gap: 12px; display: flex; align-items: center;">
                  <div style="flex:1; position: relative;">
                    <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-weight: 700; font-size: 0.9rem;">RM</span>
                    <input type="number" class="form-input" id="minBudget" value="5" min="1" max="50" style="padding-left: 42px; font-weight: 600; color: var(--text-primary); border-radius: 10px;">
                  </div>
                  <span class="text-muted" style="font-weight: 600; color: var(--text-muted);">—</span>
                  <div style="flex:1; position: relative;">
                    <span style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-weight: 700; font-size: 0.9rem;">RM</span>
                    <input type="number" class="form-input" id="maxBudget" value="15" min="5" max="100" style="padding-left: 42px; font-weight: 600; color: var(--text-primary); border-radius: 10px;">
                  </div>
                </div>
              </div>

              <div class="constraint-group" style="margin-bottom:0;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:8px;">
                  <span class="constraint-label" style="margin-bottom:0;">Max Prep Time</span>
                  <div style="display:flex; align-items:center; gap:10px;">
                    <span id="prepTimeVal" style="font-weight:700; font-size:0.9rem; color:var(--accent);">30 mins</span>
                    <label class="toggle" style="transform:scale(0.85);">
                      <input type="checkbox" id="prepTimeToggle" checked onchange="togglePrepTime()">
                      <span class="toggle-slider"></span>
                    </label>
                  </div>
                </div>
                <div id="prepTimeWrap" style="margin-top: 16px; margin-bottom: 8px;">
                  <input type="range" id="maxPrepTime" class="custom-slider" min="10" max="120" step="5" value="30" 
                        oninput="document.getElementById('prepTimeVal').textContent = this.value + ' mins'" />
                </div>
              </div>
            </div>

            <div class="constraint-card">
              <div class="constraint-header"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;vertical-align:text-bottom;"><line x1="12" y1="3" x2="12" y2="21"></line><path d="M3 14h18"></path><path d="M5 14v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4"></path></svg> Dietary Controls</div>
              
              <div class="constraint-group">
                <div class="toggle-group">
                  <span class="toggle-label" style="font-weight:600; font-size:0.85rem;">Enforce Halal</span>
                  <label class="toggle">
                    <input type="checkbox" id="halalToggle" checked>
                    <span class="toggle-slider"></span>
                  </label>
                </div>
              </div>

              <div class="constraint-group">
                <div class="toggle-group" style="margin-bottom:10px;">
                  <span class="toggle-label" style="font-weight:600; font-size:0.85rem;">Enable Caloric Threshold</span>
                  <label class="toggle">
                    <input type="checkbox" id="calToggle" onchange="document.getElementById('calWrap').style.display=this.checked?'flex':'none'">
                    <span class="toggle-slider"></span>
                  </label>
                </div>
                <div class="range-wrapper" id="calWrap" style="display:none; gap: 12px; align-items: center; margin-top: 12px;">
                  <div style="flex:1; position: relative;">
                    <input type="number" class="form-input" id="minCal" value="300" step="50" style="padding-right: 42px; font-weight: 600; border-radius: 10px;">
                    <span style="position: absolute; right: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.8rem;">kcal</span>
                  </div>
                  <span class="text-muted" style="font-weight: 600; color: var(--text-muted);">—</span>
                  <div style="flex:1; position: relative;">
                    <input type="number" class="form-input" id="maxCal" value="800" step="50" style="padding-right: 42px; font-weight: 600; border-radius: 10px;">
                    <span style="position: absolute; right: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 0.8rem;">kcal</span>
                  </div>
                </div>
              </div>

              <div class="constraint-group">
                <div class="toggle-group">
                  <div>
                    <span class="toggle-label" style="font-weight:600; font-size:0.85rem;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:4px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg> Strict Fridge Mode</span>
                    <p style="font-size:.72rem; color:var(--text-muted); margin-top:4px;">Only use ingredients currently in your fridge</p>
                  </div>
                  <label class="toggle">
                    <input type="checkbox" id="strictFridgeToggle">
                    <span class="toggle-slider"></span>
                  </label>
                </div>
              </div>

              <div class="constraint-group" style="margin-bottom:0;">
                <div class="toggle-group">
                  <div>
                    <span class="toggle-label" style="font-weight:600; font-size:0.85rem;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--success)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:middle;margin-right:4px;"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg> Health Optimization</span>
                    <p style="font-size:.72rem; color:var(--text-muted); margin-top:4px;">Apply your BMI & goal to recipe selection</p>
                  </div>
                  <label class="toggle">
                    <input type="checkbox" id="healthModeToggle" checked onchange="updateHealthBadge()">
                    <span class="toggle-slider"></span>
                  </label>
                </div>
              </div>
            </div>

            <div class="constraint-card">
              <div class="constraint-header"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;vertical-align:text-bottom;"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path></svg> Flavor & Meal Profile</div>
              
              <div class="constraint-group">
                <span class="constraint-label">Meal Category</span>
                <div style="position: relative;">
                  <select class="form-select custom-select" id="mealTypeSelect" style="appearance: none; -webkit-appearance: none; padding-right: 36px; border-radius: 10px; font-weight: 500;">
                    <option>Any Meal</option>
                    <option>Breakfast</option>
                    <option>Lunch</option>
                    <option>Dinner</option>
                    <option>Snack / Light Bite</option>
                  </select>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; right: 14px; top: 50%; transform: translateY(-50%); pointer-events: none; color: var(--text-muted);"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </div>
              </div>

              <div class="constraint-group">
                <span class="constraint-label">Cuisine Filter</span>
                <div style="position: relative;">
                  <select class="form-select custom-select" id="cuisineSelect" style="appearance: none; -webkit-appearance: none; padding-right: 36px; border-radius: 10px; font-weight: 500;" onchange="document.getElementById('stateWrap').style.display=this.value==='Local (Malaysian)'?'block':'none'">
                    <option>Local (Malaysian)</option>
                    <option>Asian</option>
                    <option>Western</option>
                    <option>Middle Eastern</option>
                    <option>Fusion / Any</option>
                  </select>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; right: 14px; top: 50%; transform: translateY(-50%); pointer-events: none; color: var(--text-muted);"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </div>
              </div>

              <div class="constraint-group" id="stateWrap" style="margin-bottom:0;">
                <span class="constraint-label">State-Specific Origin</span>
                <div style="position: relative;">
                  <select class="form-select custom-select" id="stateSelect" style="appearance: none; -webkit-appearance: none; padding-right: 36px; border-radius: 10px; font-weight: 500;">
                    <option>Any State</option>
                    <option>Johor</option><option>Kedah</option><option>Kelantan</option>
                    <option>Melaka</option><option>Negeri Sembilan</option><option>Pahang</option>
                    <option>Penang</option><option>Perak</option><option>Perlis</option>
                    <option>Sabah</option><option>Sarawak</option><option>Selangor</option>
                    <option>Terengganu</option>
                  </select>
