<script>
  const user = JSON.parse(sessionStorage.getItem('user')||'null');
  if (!user) window.location.href='/';

  // Init UI
  document.getElementById('userAvatar').textContent=(user.username||'U')[0].toUpperCase();
  document.getElementById('sidebarUsername').textContent=user.username||'User';
  document.getElementById('sidebarGoal').textContent=user.health_goal||'';
  document.getElementById('sidebarBmi').textContent=user.bmi||'—';
  document.getElementById('sidebarActivity').textContent=(user.activity_level||'').split(' ')[0];

  // Theme
  const saved=localStorage.getItem('theme')||'light';
  document.documentElement.setAttribute('data-theme',saved);
  const themeBtn=document.getElementById('themeToggle');
  themeBtn.textContent=saved==='dark'?'☀️':'🌙';
  themeBtn.onclick=()=>{
    const next=document.documentElement.getAttribute('data-theme')==='dark'?'light':'dark';
    document.documentElement.setAttribute('data-theme',next);
    localStorage.setItem('theme',next);
    themeBtn.textContent=next==='dark'?'☀️':'🌙';
  };

  const tabTitles={inventory:'🧊 My Fridge',planner:'🍳 Meal Engine',cookbook:'📖 Cookbook',quicklist:'🛒 Quick List',profile:'👤 My Profile'};
  function switchTab(name,el){
    document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
    document.querySelectorAll('.nav-item').forEach(b=>b.classList.remove('active'));
    document.getElementById('tab-'+name).classList.add('active');
    el.classList.add('active');
    document.getElementById('topbarTitle').textContent=tabTitles[name];
    if(name==='cookbook') loadCookbook();
    if(name==='quicklist') loadQuickList();
    if(name==='profile') loadProfile();
  }
  function showLogoutModal() { document.getElementById('logoutModal').style.display = 'flex'; }
  function closeLogoutModal() { document.getElementById('logoutModal').style.display = 'none'; }
  function handleLogout(){ sessionStorage.clear(); window.location.href='/'; }
  function toggleCalories(){
    document.getElementById('calRangeWrap').style.display=document.getElementById('calToggle').checked?'flex':'none';
  }
  function toggleStateSelect(){
    document.getElementById('stateWrap').style.display=document.getElementById('cuisineSelect').value==='Local (Malaysian)'?'block':'none';
  }

  // --- RESPONSIVE HAMBURGER NAVIGATION ---
  const mobileMenuBtn = document.getElementById('mobileMenuBtn');
  const sidebar = document.querySelector('.sidebar');

  // Toggle sidebar slide when clicking the ☰ button
  if (mobileMenuBtn && sidebar) {
    mobileMenuBtn.addEventListener('click', (e) => {
      e.stopPropagation(); // Prevents instant closing
      sidebar.classList.toggle('open');
    });
  }

  // Auto-close sidebar when clicking a navigation link on mobile
  document.querySelectorAll('.nav-item').forEach(item => {
    item.addEventListener('click', () => {
      if (window.innerWidth <= 900 && sidebar) {
        sidebar.classList.remove('open');
      }
    });
  });

  // Tap anywhere outside the sidebar to dismiss it smoothly
  document.addEventListener('click', (e) => {
    if (window.innerWidth <= 900 && sidebar && sidebar.classList.contains('open')) {
      if (!sidebar.contains(e.target) && e.target !== mobileMenuBtn) {
        sidebar.classList.remove('open');
      }
    }
  });

  // Health badge in meal planner
  function updateHealthBadge() {
    const hb = document.getElementById('healthBadge');
    if (!hb) return;
    const enabled = document.getElementById('healthModeToggle').checked;
    if (enabled) {
      hb.style.background = 'var(--accent-soft)';
      hb.style.borderColor = 'var(--accent)';
      hb.style.color = 'var(--accent)';
      hb.textContent = '🏃 Health Mode ON — Goal: ' + (user.health_goal||'—') + ' | BMI: ' + (user.bmi||'—');
    } else {
      hb.style.background = 'var(--bg-secondary)';
      hb.style.borderColor = 'var(--border)';
      hb.style.color = 'var(--text-muted)';
      hb.textContent = '😋 Chill Mode — No health optimization applied';
    }
  }
  updateHealthBadge();

  // Prep time toggle
  function togglePrepTime() {
    const enabled = document.getElementById('prepTimeToggle').checked;
    const wrap = document.getElementById('prepTimeWrap');
    const val = document.getElementById('prepTimeVal');
    wrap.style.opacity = enabled ? '1' : '0.35';
    wrap.style.pointerEvents = enabled ? 'auto' : 'none';
    val.textContent = enabled ? document.getElementById('maxPrepTime').value + ' mins' : 'Any';
    val.style.color = enabled ? 'var(--accent)' : 'var(--text-muted)';
  }

  // PWA: Register Service Worker
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/service-worker.js')
        .then(reg => console.log('Service Worker registered!', reg))
        .catch(err => console.error('Service Worker registration failed: ', err));
    });
  }
</script>
