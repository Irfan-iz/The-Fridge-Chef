<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The Fridge Chef — Admin</title>
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#ff6b00">
  <script>document.documentElement.setAttribute('data-theme', localStorage.getItem('theme') || 'light');</script>
  <link rel="stylesheet" href="/static/css/style.css" />
  <style>
    .kpi-grid-5 { display:grid; grid-template-columns:repeat(5,1fr); gap:14px; margin-bottom:24px; }
    @media(max-width:1100px){ .kpi-grid-5{ grid-template-columns:repeat(3,1fr); } }
    @media(max-width:700px){ .kpi-grid-5{ grid-template-columns:1fr 1fr; } }

    .admin-search {
      display:flex; align-items:center; gap:10px; margin-bottom:14px;
    }
    .admin-search input {
      flex:1; padding:9px 14px; border:1.5px solid var(--border);
      border-radius:var(--radius-sm); background:var(--bg-secondary);
      color:var(--text-primary); font-family:'DM Sans',sans-serif; font-size:.9rem;
      outline:none; transition:border-color .2s;
    }
    .admin-search input:focus { border-color:var(--accent); }

    /* Modal */
    .modal-overlay {
      display:none; position:fixed; inset:0;
      background:rgba(0,0,0,0.55); backdrop-filter:blur(4px);
      z-index:500; align-items:center; justify-content:center;
    }
    .modal-overlay.show { display:flex; }
    .modal-box {
      background:var(--bg-card); border:1px solid var(--border);
      border-radius:var(--radius-lg); padding:28px; width:100%;
      max-width:480px; box-shadow:var(--shadow-lg);
      animation:cardIn .25s ease;
    }
    .modal-box h3 { font-family:'Playfair Display',serif; font-size:1.2rem; margin-bottom:16px; }

    /* Hourly chart */
    .hourly-grid {
      display:flex; align-items:flex-end; gap:4px;
      height:80px; padding:4px 0;
    }
    .hourly-bar-wrap { flex:1; display:flex; flex-direction:column; align-items:center; gap:3px; }
    .hourly-bar {
      width:100%; background:var(--accent); border-radius:4px 4px 0 0;
      transition:height .6s ease; min-height:2px;
    }
    .hourly-label { font-size:.6rem; color:var(--text-muted); }

    /* Action buttons in table */
    .action-btns { display:flex; gap:6px; flex-wrap:nowrap; }
  </style>
</head>
<body>

<!-- USER HISTORY MODAL -->
<div class="modal-overlay" id="historyModal">
  <div class="modal-box">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
      <h3 id="historyModalTitle">User Meal History</h3>
      <button class="btn btn-ghost btn-sm" onclick="closeModal('historyModal')">✕</button>
    </div>
    <div id="historyModalBody"></div>
  </div>
</div>

<!-- RESET PASSWORD MODAL -->
<div class="modal-overlay" id="resetModal">
  <div class="modal-box">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
      <h3>Reset Password</h3>
      <button class="btn btn-ghost btn-sm" onclick="closeModal('resetModal')">✕</button>
    </div>
    <p style="font-size:.85rem;color:var(--text-muted);margin-bottom:14px;">Set a new password for <strong id="resetUsername"></strong></p>
    <div class="form-group">
      <label class="form-label">New Password</label>
      <input type="text" class="form-input" id="resetPasswordInput" placeholder="Enter new password" />
    </div>
    <div id="resetAlert" style="margin-bottom:10px;"></div>
    <button class="btn btn-primary" onclick="confirmResetPassword()" id="resetConfirmBtn">🔑 Reset Password</button>
  </div>
</div>

<!-- DELETE CONFIRM MODAL -->
<div class="modal-overlay" id="deleteModal">
  <div class="modal-box">
    <h3 style="color:var(--danger);">⚠️ Delete User</h3>
    <p style="font-size:.9rem;color:var(--text-secondary);margin:14px 0;">
      Are you sure you want to delete <strong id="deleteUsername"></strong>?<br/>
      This will permanently remove all their meals, recipes and shopping list.
    </p>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:16px;">
      <button class="btn btn-ghost" onclick="closeModal('deleteModal')">Cancel</button>
      <button class="btn btn-danger" onclick="confirmDeleteUser()" id="deleteConfirmBtn">🗑️ Yes, Delete</button>
    </div>
  </div>
</div>

<div class="app-layout">
  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <h1>The Fridge<span>Chef</span></h1>
      <p>System Administration</p>
    </div>
    <div class="sidebar-user">
      <div class="user-avatar" style="background:#E8A838;">A</div>
      <div class="user-info"><p>Admin</p><span>Administrator</span></div>
    </div>
    <nav class="sidebar-nav">
      <div class="nav-section-label">Admin Panel</div>
      <button class="nav-item active"><span class="nav-icon">📊</span> Dashboard</button>
      <div class="nav-section-label" style="margin-top:12px;">System</div>
      <button class="nav-item" onclick="handleLogout()"><span class="nav-icon">🚪</span> Logout</button>
    </nav>
    <div class="sidebar-bottom">
      <div style="font-size:.72rem;color:#57534E;text-align:center;">
        System: <strong style="color:#22C55E;">● Healthy</strong>
        &nbsp;|&nbsp;
        <span id="lastRefresh" style="color:#57534E;"></span>
      </div>
    </div>
  </aside>
  <div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

  <!-- MAIN -->
  <div class="main-content">
    <div class="topbar">
      <div style="display:flex;align-items:center;gap:10px;">
        <button class="btn btn-ghost btn-sm" id="mobileMenuBtn"
          style="display:none;font-size:1.2rem;padding:4px 10px;"
          onclick="openSidebar()">☰</button>
        <div class="topbar-title">⚙️ System Administrator Dashboard</div>
      </div>
      <div class="topbar-actions">
        <button class="btn btn-ghost btn-sm" onclick="loadStats()">🔄 Refresh</button>
        <a href="/api/admin/export/users" class="btn btn-ghost btn-sm" download>📥 Export CSV</a>
        <button class="theme-toggle" id="themeToggle">🌙</button>
      </div>
    </div>

    <div class="page-content">

      <!-- KPI CARDS (5) -->
      <div class="kpi-grid-5">
        <div class="kpi-card">
          <div class="kpi-label">Registered Users</div>
          <div class="kpi-value" id="kpiUsers">—</div>
          <div class="kpi-icon">👥</div>
        </div>
        <div class="kpi-card" style="--accent:#E8A838;">
          <div class="kpi-label">Total Meals Generated</div>
          <div class="kpi-value" id="kpiMeals">—</div>
          <div class="kpi-icon">🍽️</div>
        </div>
        <div class="kpi-card" style="--accent:#8B5CF6;">
          <div class="kpi-label">Meals Today</div>
          <div class="kpi-value" id="kpiMealsToday">—</div>
          <div class="kpi-icon">📅</div>
        </div>
        <div class="kpi-card" style="--accent:#16A34A;">
          <div class="kpi-label">Total Cost Logged (RM)</div>
          <div class="kpi-value" id="kpiSavings">—</div>
          <div class="kpi-icon">💰</div>
        </div>
        <div class="kpi-card" style="--accent:#22C55E;">
          <div class="kpi-label">System Status</div>
          <div class="kpi-value" style="font-size:1.2rem;color:#22C55E;">Healthy 🟢</div>
          <div class="kpi-icon">🖥️</div>
        </div>
      </div>

      <!-- CHARTS ROW -->
      <div class="grid-2" style="margin-bottom:24px;">
        <div class="card">
          <div class="card-header"><div class="card-title">👥 User Health Demographics</div></div>
          <div class="chart-bar-container" id="healthChart">
            <div class="empty-state" style="padding:20px 0;"><p>Loading...</p></div>
          </div>
        </div>
        <div class="card">
          <div class="card-header"><div class="card-title">🏆 Top Generated Recipes</div></div>
          <div class="chart-bar-container" id="recipeChart">
            <div class="empty-state" style="padding:20px 0;"><p>Loading...</p></div>
          </div>
        </div>
      </div>

      <!-- PEAK USAGE CHART -->
      <div class="card" style="margin-bottom:24px;">
        <div class="card-header">
          <div class="card-title">📈 Peak Usage Hours (All Time)</div>
          <span style="font-size:.78rem;color:var(--text-muted);">Meals generated per hour</span>
        </div>
        <div class="hourly-grid" id="hourlyChart">
          <div class="empty-state" style="padding:10px 0;width:100%;"><p>No data yet.</p></div>
        </div>
        <div style="display:flex;justify-content:space-between;margin-top:4px;padding:0 2px;">
          <span style="font-size:.65rem;color:var(--text-muted);">12am</span>
          <span style="font-size:.65rem;color:var(--text-muted);">6am</span>
          <span style="font-size:.65rem;color:var(--text-muted);">12pm</span>
          <span style="font-size:.65rem;color:var(--text-muted);">6pm</span>
          <span style="font-size:.65rem;color:var(--text-muted);">11pm</span>
        </div>
      </div>

      <!-- USER DIRECTORY -->
      <div class="card">
        <div class="card-header">
          <div class="card-title">📋 User Directory</div>
          <div style="display:flex;gap:8px;align-items:center;">
            <span id="userCountBadge" class="tag">0 users</span>
          </div>
        </div>

        <!-- SEARCH BAR -->
        <div class="admin-search">
          <input type="text" id="userSearchInput" placeholder="🔍 Search by username, phone, goal..." oninput="filterUsers()" />
          <select class="form-select" id="genderFilter" onchange="filterUsers()" style="width:120px;">
            <option value="">All Genders</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
          </select>
          <select class="form-select" id="goalFilter" onchange="filterUsers()" style="width:160px;">
            <option value="">All Goals</option>
            <option value="Maintain">Maintain</option>
            <option value="Deficit">Weight Loss</option>
            <option value="Surplus">Weight Gain</option>
          </select>
        </div>

        <div style="overflow-x:auto;">
          <table class="data-table">
            <thead>
              <tr>
                <th>ID</th><th>Username</th><th>Phone</th><th>Age</th>
                <th>Gender</th><th>Height</th><th>Weight</th><th>BMI</th>
                <th>Goal</th><th>Activity</th><th>Allergies</th><th>Actions</th>
              </tr>
            </thead>
            <tbody id="userTableBody">
              <tr><td colspan="12" style="text-align:center;color:var(--text-muted);padding:24px;">Loading...</td></tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
</div>

<script src="/static/js/auth.js"></script>
<script src="/static/js/admin.js"></script>
<script>
  const user = JSON.parse(sessionStorage.getItem('user') || 'null');
  if (!user || !user.is_admin) window.location.href = '/';

  // Theme
  const themeBtn = document.getElementById('themeToggle');
  themeBtn.textContent = document.documentElement.getAttribute('data-theme') === 'dark' ? '☀️' : '🌙';
  themeBtn.onclick = () => {
    const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    themeBtn.textContent = next === 'dark' ? '☀️' : '🌙';
  };

  // Mobile sidebar
  function openSidebar() {
    document.getElementById('sidebar').classList.add('open');
    document.getElementById('sidebarOverlay').classList.add('show');
  }
  function closeSidebar() {
    document.getElementById('sidebar').classList.remove('open');
    document.getElementById('sidebarOverlay').classList.remove('show');
  }
  function handleLogout() { sessionStorage.clear(); window.location.href = '/'; }
  function closeModal(id) { document.getElementById(id).classList.remove('show'); }

  // Auto-refresh every 30 seconds
  loadStats();
  setInterval(loadStats, 30000);

  // PWA: Register Service Worker
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/service-worker.js')
        .then(reg => console.log('Service Worker registered!', reg))
        .catch(err => console.error('Service Worker registration failed: ', err));
    });
  }
</script>
</body>
</html>